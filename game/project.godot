; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this is a text file so it can be hand-tweaked.

config_version=5

[application]

config/name="Wizard Wars"
config/description="Two-player motion-controlled duel: fire wizard versus water wizard. Plays with a webcam or a depth camera."
config/version="0.9.0"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.01, 0.05, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Settings="*res://scripts/settings.gd"
BodyTracker="*res://tracking/body_tracker.gd"
Tracking="*res://scripts/tracking.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
