[configuration]

entry_symbol = "orbbec_library_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/windows/liborbbecwizard.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/liborbbecwizard.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/linux/liborbbecwizard.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/liborbbecwizard.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/linux/liborbbecwizard.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/linux/liborbbecwizard.linux.template_release.arm64.so"

[dependencies]

windows.x86_64 = { "res://bin/windows/OrbbecSDK.dll": "" }
linux.x86_64 = { "res://bin/linux/libOrbbecSDK.so": "", "res://bin/linux/libOrbbecSDK.so.2": "" }
linux.arm64 = { "res://bin/linux/libOrbbecSDK.so": "", "res://bin/linux/libOrbbecSDK.so.2": "" }
