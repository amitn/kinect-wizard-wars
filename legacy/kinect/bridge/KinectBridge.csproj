<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only Kinect v2 -> UDP bridge.
    Requires the Kinect for Windows SDK 2.0, which sets KINECTSDK20_DIR.
    Build:  dotnet build -c Release
    Run:    bin\Release\net48\KinectBridge.exe [host] [port]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>KinectBridge</RootNamespace>
    <AssemblyName>KinectBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Kinect">
      <HintPath>$(KINECTSDK20_DIR)Assemblies\Microsoft.Kinect.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
